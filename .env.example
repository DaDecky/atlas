# Run `make env` to fill the empty secrets. Never commit .env.

## PVMBG_TOKEN is shaped pvmbg.<key-id>.<secret>.
BMKG_API_KEY=
PVMBG_TOKEN=
AGGREGATOR_INTERNAL_TOKEN=

## The Audit API token. The assistants give the real one for the exam, and make env generates a local one.
AUDIT_TOKEN=

## The Sensor Pantai token. The sensor and the Aggregator share it.
PANTAI_AUTH_TOKEN=
AUTH_VALIDATE_TOKEN=
AUTH_ED25519_PRIVATE_KEY_B64=
AUTH_ED25519_PUBLIC_KEY_B64=

MEDIA_CLIENT_ID=media
MEDIA_CLIENT_SECRET=
FIELD_TEAM_CLIENT_ID=field-team
FIELD_TEAM_CLIENT_SECRET=
INTERNAL_OPS_CLIENT_ID=internal-ops
INTERNAL_OPS_CLIENT_SECRET=

CANONICAL_DB_PASSWORD=
AUTH_DB_PASSWORD=
BMKG_DB_PASSWORD=
PVMBG_DB_PASSWORD=
RABBITMQ_PASSWORD=

## Superuser of the BNPB Postgres container, used once to create the owner roles.
POSTGRES_ADMIN_PASSWORD=

# Everything below is optional and shows the default. Remove the leading `# ` to change one.

## Host ports. Spec: BMKG 8081, PVMBG 8082, Client API 8080.
# BMKG_PORT=8081
# PVMBG_PORT=8082
# CLIENT_API_PORT=8080
# AUTH_PORT=8084

## Source mocks. Spec: PVMBG 500ms-3s, events at most 10s apart.
# PVMBG_MIN_RESPONSE_DELAY=500ms
# PVMBG_MAX_RESPONSE_DELAY=3s
# PVMBG_RESPONSE_DELAY_FLOOR=500ms
# PVMBG_RESPONSE_DELAY_CEILING=3s
# BMKG_RESPONSE_DELAY=100ms
# BMKG_RESPONSE_DELAY_FLOOR=50ms
# BMKG_RESPONSE_DELAY_CEILING=150ms
# SOURCE_EVENT_INTERVAL=10s
# EVENT_INTERVAL_CEILING=10s
# OUTAGE_MAX_HANG=1m
# SEED=4031
# MIN_SEED_RECORDS=20

## Aggregator. Spec: polling every 2s-5s suggested.
# POLL_INTERVAL=3s
# SOURCE_LEASE_DURATION=15s
# SOURCE_LEASE_RENEW_DEADLINE=10s
# SOURCE_LEASE_RETRY_PERIOD=2s
# SOURCE_TIMEOUT=4s
# SOURCE_RETRIES=2
# RETRY_BACKOFF=200ms
# SOURCE_IDLE_CONN_TIMEOUT=30s
# MAX_SOURCE_RECORDS=1000
# MAX_SOURCE_BYTES=4194304
# QUERY_TIMEOUT=2s
# Set to 0s to disable first-page read caching.
# HAZARD_READ_CACHE_TTL=1s
# QUERY_CAPACITY=64
# QUERY_POOL_SIZE=8
# INGEST_POOL_SIZE=2
# PUBLISH_TIMEOUT=3s
# FAILURE_MARK_TIMEOUT=2s
# WARNING_LOOKBACK=1h
# AUDIT_TIMEOUT=10s
# OPS_CAPACITY=2

## Replicated store. Each copy call has its own deadline inside the 2s read budget.
# SHARD_DEADLINE=400ms
# READ_HEDGE_DELAY=150ms
# SHARD_READ_WORKERS=8
# REFILL_VERIFY_ATTEMPTS=5
# DATA_INGEST_POOL_SIZE=4
# DATA_QUERY_POOL_SIZE=8

## Sensor Pantai adapter. Spec: critical alerts within 5s at p95, and expired data marks the sensor sick.
# SENSOR_POLL_INTERVAL=1s
# SENSOR_TIMEOUT=2s
# SENSOR_STALE_AFTER=5m

## Auth. Spec: access token TTL defaults to 60s.
# ACCESS_TOKEN_TTL=60s
# REFRESH_TOKEN_TTL=168h
# AUTH_MAX_BODY_BYTES=8192

## Client API.
# CLIENT_API_OUTBOUND_TIMEOUT=3s
# CLIENT_API_REQUEST_CAPACITY=128
# MAX_RETRY_AFTER=1h
# AGGREGATOR_MAX_RESPONSE_BYTES=4194304
# AUTH_VALIDATE_MAX_BYTES=4096

## Admission. Spec: Field Team is served while Media is refused. Client API and Aggregator read it.
# FIELD_TEAM_RESERVED_PERCENT=25

## Consumers.
# CONSUMER_PREFETCH=1
# CONSUMER_QUEUE_MAX_LENGTH=10000
# CONSUMER_QUEUE_MAX_BYTES=67108864
# CONSUMER_MESSAGE_TTL=1h

## HTTP servers. Each service reads the names it uses, and the consumers default lower.
# HTTP_READ_HEADER_TIMEOUT=3s
# HTTP_READ_TIMEOUT=5s
# HTTP_WRITE_TIMEOUT=5s
# HTTP_IDLE_TIMEOUT=30s
# HTTP_MAX_HEADER_BYTES=16384
# SHUTDOWN_TIMEOUT=5s

## Databases. The pool size and store timeout apply to Auth and the mocks only.
# STARTUP_TIMEOUT=15s
# DB_CONNECT_TIMEOUT=2s
# DB_POOL_SIZE=8
# STORE_TIMEOUT=2s

## Broker. The dial timeout and reconnect delay apply to the consumers only.
# BROKER_HEARTBEAT=10s
# BROKER_DIAL_TIMEOUT=3s
# BROKER_RECONNECT_DELAY=1s
